# Private, single-operator experiments only. Deployment is not approved yet.
# Generate a unique random password (at least 32 characters); never commit it.
EXPERIMENT_USERNAME=operator
EXPERIMENT_PASSWORD=
SECRET_KEY=
FLASK_DEBUG=false

# Documents/prompts may be sent to these external providers.
# Use restricted-budget credentials and non-sensitive test data only.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL_NAME=gpt-4o-mini
ZEP_API_KEY=

# Optional secondary model; omit these until explicitly configured.
# LLM_BOOST_API_KEY=
# LLM_BOOST_BASE_URL=
# LLM_BOOST_MODEL_NAME=
